# LOCAL DEV ONLY. Copy to .env (git-ignored). In production set these in the Netlify UI.
# WARNING: anything here is compiled into the public JS bundle at build time.
NETLIFY_MCP_ENDPOINT=
NETLIFY_MCP_API_KEY=
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_USER_ID=
NEWSAPI_KEY=
# Set to true to lock the build to mock/demo mode
FORCE_MOCK=

# ---- SERVER-SIDE ONLY (Netlify functions). Never bundled into the browser. ----
ANTHROPIC_API_KEY=
# Optional: Claude model for reviews (default claude-opus-5-5; claude-sonnet-5-5 is faster/cheaper)
REVIEW_MODEL=
# Optional: extra news source
FINNHUB_KEY=
# Optional but recommended: shared token required by /api/* (enter it in Settings)
APP_ACCESS_TOKEN=
